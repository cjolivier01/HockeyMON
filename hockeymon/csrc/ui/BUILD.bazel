load("@rules_cc//cc:defs.bzl", "cc_library")
load("@libtorch//:torch_backend.bzl", "TORCH_BACKEND")

INCLUDE_PREFIX = "hockeymon/csrc/ui"
ROCM_COMPAT_COPTS = ["-DJETSON_USE_HIP"] if TORCH_BACKEND == "rocm" else []

cc_library(
    name = "hm_render_set",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    defines = [
        # Match the ABI used by the vendored PyTorch wheels.
        "_GLIBCXX_USE_CXX11_ABI=1",
    ],
    copts = [
        "-fopenmp",
        "-fPIC",
        "-Wno-error=comment",
    ] + ROCM_COMPAT_COPTS,
    deps=[
      "@jetson-utils//cuda:cuda_compat_includes",
      "@jetson-utils//display",
    ]
)
