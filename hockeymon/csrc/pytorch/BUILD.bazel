load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@libtorch//:torch_backend.bzl", "TORCH_BACKEND")

ROCM_COMPAT_COPTS = (
    [
        "-DJETSON_USE_HIP",
        "-DC10_CUDA_NO_CMAKE_CONFIGURE_FILE",
    ] if TORCH_BACKEND == "rocm" else []
)

CUDA_KERNEL_COMPATIBLE_WITH = [] if TORCH_BACKEND == "cuda" else ["@platforms//:incompatible"]
ROCM_KERNEL_COMPATIBLE_WITH = [] if TORCH_BACKEND == "rocm" else ["@platforms//:incompatible"]
GPU_OPS_COMPATIBLE_WITH = (
    [] if TORCH_BACKEND in ["cuda", "rocm"] else ["@platforms//:incompatible"]
)
BYTETRACK_KERNEL_DEPS = (
    [
        ":bytetrack_cuda_kernels_hip",
        "@rocm_sdk_includes//:amdhip64",
    ] if TORCH_BACKEND == "rocm" else [
        ":bytetrack_cuda_kernels_cuda",
        "@jetson-utils//cuda:cuda_compat_includes",
    ] if TORCH_BACKEND == "cuda" else []
)

cc_library(
    name = "pytorch_stitch",
    srcs = glob(
        ["*.cpp"],
        exclude = ["bytetrack_cuda_ops.cpp"],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = ["bytetrack_cuda_ops.h"],
    ),
    copts = [
        "-fopenmp",
        "-fPIC",
        "-Wno-error=comment",
    ] + ROCM_COMPAT_COPTS,
    includes = [
        ".",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@jetson-utils//cuda:cuda_compat_includes",
        "@libtorch",
    ],
)

genrule(
    name = "bytetrack_cuda_kernels_cuda_archive",
    srcs = [
        "bytetrack_cuda_kernels.cu",
        "bytetrack_cuda_ops.h",
        "torch_cuda_compat.h",
        "@jetson-utils//cuda:cuda_compat_includes",
    ],
    outs = ["libbytetrack_cuda_kernels_cuda.a"],
    cmd = """
set -e
NVCC="$(location @cuda_sdk//:nvcc)"
if [ ! -x "$${NVCC}" ]; then
  echo "CUDA backend selected but nvcc is unavailable. Install CUDA or use a ROCm env." >&2
  exit 1
fi
CUDA_ROOT="$$(cd "$$(dirname "$${NVCC}")/.." && pwd)"
OBJ="$(@D)/bytetrack_cuda_kernels.o"
CUDA_GENCODE_FLAGS=""

if [ -n "$${CUDA_BAZEL_ARCHS:-}" ]; then
  OLD_IFS="$${IFS}"
  IFS=';'
  for group in $${CUDA_BAZEL_ARCHS}; do
    [ -n "$${group}" ] || continue
    case "$${group}" in
      *:*)
        virtual_arch="$${group%%:*}"
        codes="$${group#*:}"
        ;;
      *)
        virtual_arch="$${group%%,*}"
        codes="$${group}"
        ;;
    esac
    virtual_arch="$${virtual_arch#sm_}"
    virtual_arch="$${virtual_arch#compute_}"

    IFS=','
    for code in $${codes}; do
      [ -n "$${code}" ] || continue
      case "$${code}" in
        sm_*)
          code_flag="sm_$${code#sm_}"
          ;;
        compute_*)
          code_flag="compute_$${code#compute_}"
          ;;
        *)
          code_flag="sm_$${code}"
          ;;
      esac
      CUDA_GENCODE_FLAGS="$${CUDA_GENCODE_FLAGS} -gencode arch=compute_$${virtual_arch},code=$${code_flag}"
    done
    IFS=';'
  done
  IFS="$${OLD_IFS}"
fi

"$${NVCC}" -c --std=c++17 -Xcompiler=-fPIC -O2 \
  $${CUDA_GENCODE_FLAGS} \
  -I. \
  -I"$${CUDA_ROOT}/include" \
  -Iexternal/libtorch/include \
  -Iexternal/libtorch/include/torch/csrc/api/include \
  -Iexternal/jetson-utils/cuda \
  $(location bytetrack_cuda_kernels.cu) -o "$${OBJ}"
ar rcs "$@" "$${OBJ}"
""",
    tags = ["no-sandbox"],
    tools = ["@cuda_sdk//:nvcc"],
    target_compatible_with = CUDA_KERNEL_COMPATIBLE_WITH,
)

cc_import(
    name = "bytetrack_cuda_kernels_cuda",
    static_library = ":bytetrack_cuda_kernels_cuda_archive",
    alwayslink = True,
    visibility = ["//visibility:private"],
    target_compatible_with = CUDA_KERNEL_COMPATIBLE_WITH,
)

genrule(
    name = "bytetrack_cuda_kernels_hip_archive",
    srcs = [
        "bytetrack_cuda_kernels.cu",
        "bytetrack_cuda_ops.h",
        "torch_cuda_compat.h",
        "@jetson-utils//cuda:cuda_compat_hdrs",
    ],
    outs = ["libbytetrack_cuda_kernels_hip.a"],
    cmd = """
set -e
HIPCC="$(location @rocm_sdk_includes//:hipcc)"
ROCM_ROOT="$$(cd "$$(dirname "$${HIPCC}")/.." && pwd)"
ROCM_INCLUDE_OVERLAY="$(@D)/rocm_include"
OBJ="$(@D)/bytetrack_cuda_kernels.o"
mkdir -p "$${ROCM_INCLUDE_OVERLAY}"
ln -sfn "$${ROCM_ROOT}/include/thrust" "$${ROCM_INCLUDE_OVERLAY}/thrust"
ln -sfn "$${ROCM_ROOT}/include/hip" "$${ROCM_INCLUDE_OVERLAY}/hip"
if [ -d "$${ROCM_ROOT}/include/hipcub" ]; then
  ln -sfn "$${ROCM_ROOT}/include/hipcub" "$${ROCM_INCLUDE_OVERLAY}/hipcub"
fi
if [ -d "$${ROCM_ROOT}/include/hipcub/backend/cub" ]; then
  ln -sfn "$${ROCM_ROOT}/include/hipcub/backend/cub" "$${ROCM_INCLUDE_OVERLAY}/cub"
fi
if [ -d "$${ROCM_ROOT}/include/rocprim" ]; then
  ln -sfn "$${ROCM_ROOT}/include/rocprim" "$${ROCM_INCLUDE_OVERLAY}/rocprim"
fi
"$${HIPCC}" -c --std=c++17 -fPIC -O2 -D__HIP_PLATFORM_AMD__ -DJETSON_USE_HIP \
  -DC10_CUDA_NO_CMAKE_CONFIGURE_FILE \
  -I. \
  -I"$${ROCM_INCLUDE_OVERLAY}" \
  -Iexternal/libtorch/include \
  -Iexternal/libtorch/include/torch/csrc/api/include \
  -Iexternal/jetson-utils/cuda \
  -x hip \
  $(location bytetrack_cuda_kernels.cu) -o "$${OBJ}"
ar rcs "$@" "$${OBJ}"
""",
    tags = ["no-sandbox"],
    tools = ["@rocm_sdk_includes//:hipcc"],
    target_compatible_with = ROCM_KERNEL_COMPATIBLE_WITH,
)

cc_import(
    name = "bytetrack_cuda_kernels_hip",
    static_library = ":bytetrack_cuda_kernels_hip_archive",
    alwayslink = True,
    visibility = ["//visibility:private"],
    target_compatible_with = ROCM_KERNEL_COMPATIBLE_WITH,
)

cc_library(
    name = "bytetrack_cuda_ops",
    srcs = ["bytetrack_cuda_ops.cpp"],
    hdrs = ["bytetrack_cuda_ops.h"],
    copts = ROCM_COMPAT_COPTS,
    visibility = ["//visibility:public"],
    target_compatible_with = GPU_OPS_COMPATIBLE_WITH,
    deps = BYTETRACK_KERNEL_DEPS + [
        "@libtorch",
    ],
)
