exports_files(
    [
        ".bazel_setup.sh",
        "Pipfile",
        "Pipfile.lock",
        "pyproject.toml",
        "scripts/hm_cuda_container.py",
    ]
)


# Aggregated docs target: builds all available Doxygen docs (hockeymon core + hmlib).
filegroup(
    name = "all_doxygen_docs",
    srcs = [
        "//hockeymon:doxygen_docs",
        "//hmlib:doxygen_docs",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "with_openexr",
    define_values = {"with_openexr": "true"},
)

config_setting(
    name = "with_exiv2",
    define_values = {"with_exiv2": "true"},
)

config_setting(
    name = "use_hip",
    define_values = {"backend": "hip"},
)

config_setting(
    name = "use_vulkan",
    define_values = {"backend": "vulkan"},
)
