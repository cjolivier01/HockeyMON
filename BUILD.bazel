exports_files(
    [
        ".bazel_setup.sh",
        "Pipfile",
        "Pipfile.lock",
        "pyproject.toml",
        "scripts/hm_cuda_container.py",
        "scripts/hockey_data.py",
        "scripts/hockey_pose_contract.py",
        "scripts/compare_detectors.py",
        "scripts/crowdhuman_to_hockey_classes.py",
        "scripts/fiftyone_review.py",
        "scripts/hockey_tracking_to_coco.py",
        "scripts/review_coco_dataset.py",
        "scripts/slice_detector_head.py",
        "scripts/capture_stitching_projection_frames.py",
    ]
)


# Aggregated docs target: builds all available Doxygen docs (hockeymon core + hmlib).
filegroup(
    name = "all_doxygen_docs",
    srcs = [
        "//hockeymon:doxygen_docs",
        "//hmlib:doxygen_docs",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "with_openexr",
    define_values = {"with_openexr": "true"},
)

config_setting(
    name = "with_exiv2",
    define_values = {"with_exiv2": "true"},
)

config_setting(
    name = "use_hip",
    define_values = {"backend": "hip"},
)

config_setting(
    name = "use_vulkan",
    define_values = {"backend": "vulkan"},
)
